# Developer image: the build toolchain plus a workstation, minus the source.
#
# This is deliberately thin. It is `vibe-land-builder` -- the exact image
# docker/Dockerfile's `build` stage uses, and therefore already proven able to
# compile this project, since that is what every server-image CI run does -- with
# four additions:
#
#   1. Node 22, 2. wasm-pack, 3. the wasm32 target, 4. a few dev tools.
#
# The builder can build the *server* but not the *client*: the runtime image
# builds the client in a separate `node:22-bookworm` stage, so the toolchain
# image never needed Node. On a dev box you want both.
#
# It exists because a Vast instance cannot build a Docker image -- it is itself
# a container without nesting privileges -- so the only way to get a build
# environment onto a rented GPU is to arrive as one.
#
# THE SOURCE IS NOT BAKED IN. It is cloned at load by `vibe-clone`, so this
# image does not go stale every time someone pushes.
#
# NO BUILD CACHES ARE BAKED IN EITHER, and that is a deliberate reversal. An
# earlier version warmed target/ and node_modules at image build time. It cost
# ~10 GB, went stale the moment anyone pushed, and was the direct cause of every
# failure this image has had (a wasm-pack MSRV break and a wrong warm ref). The
# durable answer is a Vast *volume* mounted at the cache path below: it survives
# instance destruction and accumulates real builds instead of one stale
# snapshot. See `vibe-clone` and the vastai-deploy skill.
#
# Build:  see .github/workflows/dev-image.yml
# Run:    vastai create instance <id> --image <this> --disk 60 --ssh --direct
#
# NOTE ON LAUNCH MODE: this image is for `--ssh --direct`, which injects SSH and
# does NOT run an ENTRYPOINT. That is the opposite of the runtime image, which
# uses `--args` (container as-is, no SSH). Getting this backwards is why no box
# in the original investigation had a shell.

ARG BUILDER_IMAGE=ghcr.io/glavin001/vibe-land-builder:cuda12.8-physx-ovphysx-5.5.1
FROM ${BUILDER_IMAGE}

# --- developer tooling -------------------------------------------------------
# The builder already has build-essential, clang, lld, cmake, ninja, git, curl
# and python3. These are what you want when the box is your workstation rather
# than a build step.
RUN apt-get update && apt-get install -y --no-install-recommends \
      jq ripgrep tmux vim less rsync openssh-client procps htop \
      bash-completion ca-certificates gnupg \
 && rm -rf /var/lib/apt/lists/*

# Node 22. Ubuntu 24.04's `nodejs` package is 18.x, which is too old for the
# client build -- ci.yml pins 22 for the wasm/client job and docker/Dockerfile
# builds it on node:22-bookworm. The apt version fails deep inside the build
# rather than with an honest version error.
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && rm -rf /var/lib/apt/lists/* \
 && node --version && npm --version

# wasm-pack from the prebuilt-binary installer, NOT `cargo install`.
#
# `cargo install wasm-pack --locked` fails against this image's pinned Rust:
#
#   error: failed to compile `wasm-pack v0.15.0`
#   Caused by: rustc 1.90.0 is not supported by the following package:
#     cargo-platform@0.3.3 requires rustc 1.91
#
# `--locked` does not help -- the constraint is a dependency's rust-version, not
# the lockfile. Bumping the toolchain to satisfy a dev tool would change what
# the server compiles with, which is a deliberate pin (Dockerfile.builder:25).
# The installer downloads a release binary and cares about neither. This is
# what docker/Dockerfile's web stage already does.
RUN rustup target add wasm32-unknown-unknown \
 && curl -sSf https://rustwasm.github.io/wasm-pack/installer/init.sh | sh \
 && wasm-pack --version

# --- the clone helper --------------------------------------------------------
COPY docker/vibe-clone /usr/local/bin/vibe-clone
RUN chmod +x /usr/local/bin/vibe-clone

# Where `vibe-clone` keeps target/ and node_modules so they survive re-cloning
# and switching refs. Mount a Vast volume here to keep them across instances.
ENV VIBE_CACHE=/opt/vibe-cache
RUN mkdir -p "$VIBE_CACHE"

# Running as root against a tree git did not create.
RUN git config --global --add safe.directory '*'

# --- provenance --------------------------------------------------------------
ARG REPO_URL=https://github.com/Glavin001/vibe-land
RUN mkdir -p /opt/vibe-land \
 && { \
      echo "image=dev"; \
      echo "repo_url=${REPO_URL}"; \
      echo "node=$(node --version)"; \
      echo "npm=$(npm --version)"; \
      echo "rust=$(rustc --version | cut -d' ' -f2)"; \
      echo "wasm_pack=$(wasm-pack --version | cut -d' ' -f2)"; \
      cat /opt/toolchain/sources.txt 2>/dev/null || echo "toolchain_sources=unknown"; \
    } > /opt/vibe-land/dev-image.txt \
 && cat /opt/vibe-land/dev-image.txt

# Fail here rather than on the box, where rent is already being paid.
RUN command -v node >/dev/null \
 && command -v npm >/dev/null \
 && command -v wasm-pack >/dev/null \
 && command -v vibe-clone >/dev/null \
 && rustup target list --installed | grep -qx wasm32-unknown-unknown \
 && test -f "$PHYSX_ROOT/bin/linux.x86_64/release/libPhysXGpu_64.so" \
 && test -f "$CUDA_HOME/bin/nvcc"

WORKDIR /root

# No ENTRYPOINT and no CMD: Vast's `--ssh` launch mode replaces both, and the
# server is started by hand once you are on the box.
#
# To push commits from the box, supply credentials at RUNTIME, never in a layer:
#
#   on the box:  git remote set-url origin https://<token>@github.com/<owner>/<repo>
#                git config user.name  "..."   &&  git config user.email "..."
#
# A token baked into a layer ships with the image and cannot be removed by
# deleting a later one.
