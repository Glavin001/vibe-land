#!/usr/bin/env bash
# One command from a fresh SSH session to a playable city.
#
# Clones (if needed), builds the server and the client, mints a certificate,
# works out this box's public address, starts the server, and prints the URL.
# Safe to re-run: every step is skipped when it is already done.
#
#   vibe-up                    # default branch
#   vibe-up my-branch          # a branch, tag or commit
#   vibe-up --downtown         # the big scene (default is the small one)
#   vibe-up --scene <file>     # a specific scene json
#   vibe-up --rebuild          # force a rebuild even if binaries exist
#   vibe-up --status | --stop
#
# WHY THIS EXISTS: scripts/run-city-server.sh is written for a laptop, and five
# of its defaults are wrong on a rented box in ways that fail late and look like
# unrelated problems -- a hardcoded home IP, UDP bound on 4434 while the images
# map 4433, a localhost-only API bind, no HTTPS listener at all, and a client
# directory that exists only inside the runtime image. Assembling those by hand
# took four round trips the first time. This does it from the box's own facts.
set -euo pipefail

REPO="${VIBE_DEST:-/root/vibe-land}"
SCENE="fractured-highrise-10f.json"
REF=""
REBUILD=0
ACTION=start

while [[ $# -gt 0 ]]; do
  case "$1" in
    --scene) SCENE="$2"; shift 2 ;;
    --downtown) SCENE="fractured-downtown.json"; shift ;;
    --rebuild) REBUILD=1; shift ;;
    --status) ACTION=status; shift ;;
    --stop) ACTION=stop; shift ;;
    -h|--help) sed -n '2,12p' "${BASH_SOURCE[0]}" | sed 's/^# \?//'; exit 0 ;;
    -*) echo "unknown option: $1" >&2; exit 2 ;;
    *) REF="$1"; shift ;;
  esac
done

say() { printf '\n\033[1;36m==> %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m[!] %s\033[0m\n' "$*" >&2; }

if [[ "$ACTION" != start ]]; then
  if [[ ! -x "$REPO/scripts/run-city-server.sh" ]]; then
    echo "no checkout at $REPO yet -- run 'vibe-up' first." >&2
    exit 1
  fi
  exec "$REPO/scripts/run-city-server.sh" "--$ACTION"
fi

# --- 1. source ----------------------------------------------------------------
say "source"
vibe-clone ${REF:+"$REF"}

# --- 2. this box's public address ---------------------------------------------
# Vast maps container ports to host ports chosen per instance. The mapping lives
# in the container's environment as VAST_{TCP,UDP}_PORT_<internal>, but an SSH
# login shell does not inherit it -- PID 1 does, so read it from there. That is
# more reliable than /etc/environment, which is only populated if an onstart
# script happened to copy it.
port_from_pid1() {
  tr '\0' '\n' < /proc/1/environ 2>/dev/null | sed -n "s/^$1=//p" | head -1
}
udp_port="${VIBE_UDP_PORT:-${VAST_UDP_PORT_4433:-$(port_from_pid1 VAST_UDP_PORT_4433)}}"
web_port="${VIBE_WEB_PORT:-${VAST_TCP_PORT_4443:-$(port_from_pid1 VAST_TCP_PORT_4443)}}"
public_ip="${VIBE_PUBLIC_IP:-$(curl -fsS --max-time 5 https://api.ipify.org || true)}"

if [[ -z "$public_ip" ]]; then
  echo "could not determine this box's public IP; set VIBE_PUBLIC_IP." >&2
  exit 1
fi
if [[ -z "$udp_port" || -z "$web_port" ]]; then
  warn "could not read the port mapping from this container."
  warn "Ports must be declared when the instance is created:"
  warn "  --env '-p 4001:4001 -p 4443:4443 -p 4433:4433/udp'"
  warn "Look them up and pass them in:"
  warn "  vastai show instance <id> --raw | jq '.ports'"
  warn "  VIBE_UDP_PORT=<4433 external> VIBE_WEB_PORT=<4443 external> vibe-up"
  exit 1
fi
echo "public ip   : $public_ip"
echo "udp  4433 ->: $udp_port   (what clients dial for WebTransport)"
echo "web  4443 ->: $web_port   (what you open in a browser)"

# --- 3. server ----------------------------------------------------------------
# cuda-stress, not just destruction: without it the GPU stress solver is
# compiled out and the CPU one runs silently, which does not converge. Measured
# on the dense downtown: CPU broke 7,024 bonds where the GPU broke 3,283.
if [[ $REBUILD -eq 1 || ! -x "$REPO/target/release/web-fps-server" ]]; then
  say "building the server (cold builds take a while; cargo caches in /opt/vibe-cache)"
  ( cd "$REPO" && cargo build --release -p web-fps-server --features cuda-stress )
else
  echo "server binary present; --rebuild to force"
fi

# --- 4. client ----------------------------------------------------------------
# The server serves this bundle over HTTPS. Its default location is inside the
# runtime image only, so on a dev box it must be built and pointed at.
if [[ $REBUILD -eq 1 || ! -f "$REPO/client/dist/index.html" ]]; then
  say "building the client"
  ( cd "$REPO/client" && npm ci --no-audit --no-fund && npm run build )
else
  echo "client bundle present; --rebuild to force"
fi

# --- 5. run -------------------------------------------------------------------
say "starting the server on $SCENE"
VIBE_PUBLIC_IP="$public_ip" \
VIBE_UDP_PORT="$udp_port" \
VIBE_CITY_SCENE="$SCENE" \
  "$REPO/scripts/run-city-server.sh"

cat <<EOF

  open:    https://${public_ip}:${web_port}/city
           (self-signed by design -- accept the warning once. WebTransport pins
            the same certificate by hash, so the game connects regardless.)

  health:  curl -sk https://${public_ip}:${web_port}/healthz | jq
  stats:   curl -sk https://${public_ip}:${web_port}/match-stats/city-default | jq
  log:     tail -f /tmp/city-physx-server.log

  Restart is the reset -- there is no in-place city reset, so re-run vibe-up
  for an undamaged city. Add --downtown for the big scene (24,105 chunks).
EOF
