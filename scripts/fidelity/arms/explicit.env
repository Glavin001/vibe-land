# Impact arm D (the high profile's default since 2026-10-08): the static solve plus the explicit impact step (PhysX
# PxgDestructionImpactExplicit.cuh, method 2): the struck patch's bond graph
# integrated over the tick by symplectic Euler, one block per patch, no linear
# solve and no event ramp (docs/destruction/IMPACT_STEP_PLAN.md).
export VIBE_IMPACT_CAPACITY=0
export VIBE_IMPACT_STEP=1
export PX_DESTRUCTION_IMPACT_EXPLICIT=1
