# Impact arm B: the static solve plus the linear impact step (VIBE_IMPACT_STEP=1,
# the impact agent's work), without the ADMM impact solve. Once B exists and
# matches C on the comparison (scripts/verify/impact-arms.sh), high.env takes
# these flags and C stays as the reference arm.
export VIBE_IMPACT_CAPACITY=0
export VIBE_IMPACT_STEP=1
unset PX_DESTRUCTION_IMPACT_EXPLICIT
