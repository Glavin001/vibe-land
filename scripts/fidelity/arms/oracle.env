# Impact arm C, the reference: the ADMM impact solve (impact capacity E) at its
# correctness budget, the ADMM steps per solve and per evaluation its ramp needs
# to converge on the veneer house (the cannonball's first contact: 35 solves,
# 1.1e5 steps, 55 s; impact agent, docs/perf/BACKLOG.md "impact solve"). The
# budget is for correctness, not speed: this arm is the yardstick, not a product.
export VIBE_IMPACT_CAPACITY=1
unset VIBE_IMPACT_STEP
export PX_DESTRUCTION_IMPACT_ITERATIONS=131072
export PX_DESTRUCTION_IMPACT_EVAL_ITERATIONS=1000000
