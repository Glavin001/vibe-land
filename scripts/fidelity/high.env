# Engine profile "high-fidelity": every accuracy capability on. Optimisation
# work gates on this profile; the runtime profile must never regress.
# Usage: source scripts/fidelity/high.env  (or scripts/fidelity/profile.sh high CMD...)
#
# Capability                                         Flag                              Needs (SDK macro / build step)
# Bond bending and torsion from the real section      VIBE_SECTION_BENDING=1            PX_DESTRUCTION_SECTION_BENDING
# Rotational stiffness from the real section          VIBE_SECTION_ROTATION=1           PX_DESTRUCTION_SECTION_ROTATIONAL_STIFFNESS
# Bond stiffness E A / L, no area/length floors        VIBE_BOND_TRUE_STIFFNESS=1        (bridge; implied by rotation)
#   and the contact length max(d, sqrt A)              VIBE_BOND_CONTACT_LENGTH=1
# Impact capacity E + impact-pressure crush           VIBE_IMPACT_CAPACITY=1            PX_DESTRUCTION_IMPACT_CAPACITY
# Chunk crushing (comminution)                         VIBE_CRUSH=1 (pack build),        PX_DESTRUCTION_CRUSH_CORRECTION
#                                                      VIBE_NATIVE_CRUSH=1 (runtime)
# Real capacities for outdoor props and trees          VIBE_REAL_CAPACITIES=1 (pack build)
# Hulls referenced from their centroid                 TOWN_KIT_HULL_ORIGIN=centroid (pack build)
# Only the ground is fixed: above-grade footings,        TOWN_KIT_BURIED_ANCHORS=1 (pack build)
#   kerbs, ramps and plinths are concrete members on
#   buried anchors (town-kit geometry.mjs; the anchor lint)
# Players snap down onto ground within 0.2 m           VIBE_PLAYER_SNAP_TO_GROUND=1
# Force convergence besides the global residual         VIBE_NATIVE_STRESS_FORCE_TOLERANCE=1e-3
#   (the 1e-3 residual alone can hide an 80% error on a member carrying 0.2% of
#   the load: docs/verification/FIDELITY_AUDIT.md)
# No 100 rad/s spin clamp on native bodies (PhysX       VIBE_NATIVE_UNCAPPED_SPIN=1       (bridge; docs/verification/FIDELITY_AUDIT.md)
#   default; fragments inherit it)
# No sub-fatal section loss or residual-area arrest:  VIBE_STRENGTH_SHORT_TERM=1        (bridge; FIDELITY_AUDIT C1, C2)
#   a bond holds below its short-term strength and breaks at it (duration of
#   load, Gerhards 1979: sub-fatal failure takes > 29 min below 0.8 f)
# A crushed chunk's mass stays in the world as debris   VIBE_CRUSH_CONSERVE_MASS=1        (bridge; FIDELITY_AUDIT C4)
#
# The combined SDK (PhysX integration/high-fidelity 3913a3b38, install garage-hifi)
# carries every macro; scripts/fidelity/check.sh says what another SDK lacks.
export VIBE_FIDELITY=high
export VIBE_SECTION_BENDING=1
export VIBE_SECTION_ROTATION=1
export VIBE_BOND_TRUE_STIFFNESS=1
export VIBE_BOND_CONTACT_LENGTH=1
export VIBE_IMPACT_CAPACITY=1
export VIBE_CRUSH=1
export VIBE_NATIVE_CRUSH=1
export VIBE_REAL_CAPACITIES=1
export TOWN_KIT_HULL_ORIGIN=centroid
export TOWN_KIT_BURIED_ANCHORS=1
export VIBE_PLAYER_SNAP_TO_GROUND=1
export VIBE_NATIVE_UNCAPPED_SPIN=1
export VIBE_STRENGTH_SHORT_TERM=1
export VIBE_CRUSH_CONSERVE_MASS=1
export VIBE_NATIVE_STRESS_FORCE_TOLERANCE=1e-3
export PHYSX_ROOT=${HIGH_PHYSX_ROOT:-/Users/glavin/Development/PhysX/.claude/worktrees/hifi/out/install/garage-hifi}
# Packs: the high-fidelity build outputs (scripts/fidelity/build-packs.sh high).
export VIBE_PACK_SET=high
