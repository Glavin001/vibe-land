# Engine profile "high-fidelity": every accuracy capability on. Optimisation
# work gates on this profile; the runtime profile must never regress.
# Usage: source scripts/fidelity/high.env  (or scripts/fidelity/profile.sh high CMD...)
#
# Capability                                         Flag                              Needs (SDK macro / build step)
# Bond bending and torsion from the real section      VIBE_SECTION_BENDING=1            PX_DESTRUCTION_SECTION_BENDING
# Rotational stiffness from the real section          VIBE_SECTION_ROTATION=1           PX_DESTRUCTION_SECTION_ROTATIONAL_STIFFNESS
# Bond stiffness E A / L, no area/length floors        VIBE_BOND_TRUE_STIFFNESS=1        (bridge; implied by rotation)
#   and the contact length max(d, sqrt A)              VIBE_BOND_CONTACT_LENGTH=1
# The explicit impact step + impact-pressure crush    VIBE_IMPACT_STEP=1                PX_DESTRUCTION_IMPACT_STEP
#                                                     PX_DESTRUCTION_IMPACT_EXPLICIT=1
# Chunk crushing (comminution)                         VIBE_CRUSH=1 (pack build),        PX_DESTRUCTION_CRUSH_CORRECTION
#                                                      VIBE_NATIVE_CRUSH=1 (runtime)
# Real capacities for outdoor props and trees          VIBE_REAL_CAPACITIES=1 (pack build)
# Hulls referenced from their centroid                 TOWN_KIT_HULL_ORIGIN=centroid (pack build)
# Only the ground is fixed: above-grade footings,        TOWN_KIT_BURIED_ANCHORS=1 (pack build)
#   kerbs, ramps and plinths are concrete members on
#   buried anchors (town-kit geometry.mjs; the anchor lint)
# Players snap down onto ground within 0.2 m           VIBE_PLAYER_SNAP_TO_GROUND=1
# Force convergence besides the global residual         VIBE_NATIVE_STRESS_FORCE_TOLERANCE=1e-3
#   (the 1e-3 residual alone can hide an 80% error on a member carrying 0.2% of
#   the load: docs/verification/FIDELITY_AUDIT.md)
# No 100 rad/s spin clamp on native bodies (PhysX       VIBE_NATIVE_UNCAPPED_SPIN=1       (bridge; docs/verification/FIDELITY_AUDIT.md)
#   default; fragments inherit it)
# No sub-fatal section loss or residual-area arrest:  VIBE_STRENGTH_SHORT_TERM=1        (bridge; FIDELITY_AUDIT C1, C2)
#   a bond holds below its short-term strength and breaks at it (duration of
#   load, Gerhards 1979: sub-fatal failure takes > 29 min below 0.8 f)
# A crushed chunk's mass stays in the world as debris   VIBE_CRUSH_CONSERVE_MASS=1        (bridge; FIDELITY_AUDIT C4)
# A bearing joint whose fasteners fail bears on as a    VIBE_REBEARING=1                  PX_DESTRUCTION_REBEARING
#   unilateral contact: compression to its bearing
#   capacity, shear by friction, no tension, lifts off
#   and re-bears (FIDELITY_AUDIT C9; PhysX feat/rebearing)
# An intact joint's shear grows with the compression  VIBE_MOHR_COULOMB_SHEAR=1         PX_DESTRUCTION_MOHR_COULOMB_SHEAR
#   across it, f_v0 + mu sigma_c up to its cap
#   (EN 1996-1-1 3.6.2; the packs' masonry joints
#   author mu 0.4; FIDELITY_AUDIT C11; PhysX
#   feat/mohr-coulomb-shear). Proposed, not yet on.
#
# The combined SDK (PhysX integration/high-fidelity 3913a3b38, install garage-hifi)
# carries every macro; scripts/fidelity/check.sh says what another SDK lacks.
export VIBE_FIDELITY=high
export VIBE_SECTION_BENDING=1
export VIBE_SECTION_ROTATION=1
export VIBE_BOND_TRUE_STIFFNESS=1
export VIBE_BOND_CONTACT_LENGTH=1
# The impact model: the explicit impact step (PhysX PxgDestructionImpactExplicit.cuh,
# method 2; docs/destruction/IMPACT_STEP_PLAN.md): each struck patch's bond graph
# integrated over the tick, one block per patch. VIBE_IMPACT_STEP turns on the
# stage's impact machinery (its materials, contact rows, bounds and the
# impact-pressure crush: the bridge sets desc.impactCapacity for it); the ADMM
# impact solve (E, VIBE_IMPACT_CAPACITY) is retired and its budgets with it.
export VIBE_IMPACT_CAPACITY=0
export VIBE_IMPACT_STEP=1
export PX_DESTRUCTION_IMPACT_EXPLICIT=1
unset PX_DESTRUCTION_IMPACT_ITERATIONS PX_DESTRUCTION_IMPACT_EVAL_ITERATIONS
# The impact's handoff to the static verdict and the corrected pass (PhysX
# feat/impact-capacity; vibe-land docs/destruction/IMPACT_STEP_PLAN.md section 1):
# - contact routing: a contact whose peak elastic force v M sqrt(k / (M + m))
#   exceeds its struck chunk's weakest joint capacity is the impact model's on
#   every tick of contact, and its trial load (the rigid stop, M v / dt) leaves
#   the static solve's inputs. Without it the trial's 4.6e7 N on a 2 kg brick
#   was the warm start of the corrected pass's 64-iteration elastic solve, and
#   that pass's unconverged static verdict broke 2,466 of 3,113 bonds
#   (PhysX tests destruction_gpu_impact_static_handoff);
# - contact bounds per impactor body, not per struck cluster (the house is one
#   anchored body: its every contact took the largest row's bound, near zero, or
#   none at all where the struck chunks were freed: the rigid stop).
export PX_DESTRUCTION_IMPACT_ROUTE=1
# INVALID under AGENTS.md (caps PhysX contact impulses or writes velocities): PX_DESTRUCTION_IMPACT_BOUND_IMPACTOR=0
export PX_DESTRUCTION_IMPACT_BOUND_IMPACTOR=0
# - those bounds pairwise: an impactor's holds only against the clusters its rows
#   struck (gpusolver contactPairMaxImpulse). A body's own max impulse held for
#   all its contacts, so the truck's capped its contacts with debris and the
#   ground too and it drove through the house (+10..+17 m); pairwise it stops
#   inside (+6.4 m, 3/3). PhysX destruction_gpu_impact_pair_bounds.
# INVALID under AGENTS.md (caps PhysX contact impulses or writes velocities): PX_DESTRUCTION_IMPACT_BOUND_PAIRWISE=0
export PX_DESTRUCTION_IMPACT_BOUND_PAIRWISE=0
# - energy-bounded crushing: every crush is paid, all or nothing, out of the
#   kinetic energy of the body that struck it hardest, or not made. The payment
#   stopped a 100 kg ball (180 kJ) dead against a 256 kJ brick chunk and crushed
#   it anyway; a cannonball crushed a 3.8 MJ footing it never paid for.
#   PxDestructionStageStatus::crushEnergyCreated ("CRUSH ENERGY CREATED") is 0.
# INVALID under AGENTS.md (caps PhysX contact impulses or writes velocities): PX_DESTRUCTION_CRUSH_ENERGY_BOUND=0
export PX_DESTRUCTION_CRUSH_ENERGY_BOUND=0
# - the corrected pass's elastic solve warm-started from the tick's start, not
#   from the trial's iterate (Blast ExtStressGpuRestoreWarmStart; PhysX tests
#   destruction_gpu_impact_static_handoff_*_pretick).
export PX_DESTRUCTION_CORRECTED_WARM_START=1
export VIBE_CRUSH=1
export VIBE_NATIVE_CRUSH=1
export VIBE_REAL_CAPACITIES=1
export TOWN_KIT_HULL_ORIGIN=centroid
export TOWN_KIT_BURIED_ANCHORS=1
export VIBE_PLAYER_SNAP_TO_GROUND=1
export VIBE_NATIVE_UNCAPPED_SPIN=1
export VIBE_STRENGTH_SHORT_TERM=1
export VIBE_CRUSH_CONSERVE_MASS=1
export VIBE_REBEARING=1
# Proposed (C11): on once integration/high-fidelity carries PhysX feat/mohr-coulomb-shear.
export VIBE_MOHR_COULOMB_SHEAR=1
export VIBE_NATIVE_STRESS_FORCE_TOLERANCE=1e-3
export PHYSX_ROOT=${HIGH_PHYSX_ROOT:-/Users/glavin/Development/PhysX/.claude/worktrees/hifi/out/install/garage-hifi}
# Packs: the high-fidelity build outputs (scripts/fidelity/build-packs.sh high).
export VIBE_PACK_SET=high
