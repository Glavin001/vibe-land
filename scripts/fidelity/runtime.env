# Engine profile "runtime": what the game ships. Every new capability is off.
# Usage: source scripts/fidelity/runtime.env  (or scripts/fidelity/profile.sh runtime CMD...)
# The runtime profile must never regress; see docs/verification/README.md.
export VIBE_FIDELITY=runtime
unset VIBE_SECTION_BENDING VIBE_SECTION_ROTATION VIBE_IMPACT_CAPACITY VIBE_BOND_TRUE_STIFFNESS VIBE_BOND_CONTACT_LENGTH
unset VIBE_CRUSH VIBE_NATIVE_CRUSH VIBE_REAL_CAPACITIES TOWN_KIT_HULL_ORIGIN TOWN_KIT_BURIED_ANCHORS
unset VIBE_PLAYER_SNAP_TO_GROUND VIBE_NATIVE_UNCAPPED_SPIN VIBE_NATIVE_STRESS_FORCE_TOLERANCE
unset VIBE_STRENGTH_SHORT_TERM VIBE_CRUSH_CONSERVE_MASS
# The clean, current SDK (PhysX 0e0aba8a0, feature profile rigid-demo-experimental).
export PHYSX_ROOT=${RUNTIME_PHYSX_ROOT:-/Users/glavin/Development/PhysX/out/install/garage-roof}
# Packs: the default build outputs (no suffix).
export VIBE_PACK_SET=default
