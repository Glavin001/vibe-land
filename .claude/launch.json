{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "client",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd client && exec npx vite"
      ],
      "port": 3003
    },
    {
      "name": "garage-vehicle-server",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "VIBE_GARAGE_BALL_MASS=${VIBE_GARAGE_BALL_MASS:-1000} exec scripts/perf/garage-vehicle-server.sh --no-build"
      ],
      "port": 4001
    },
    {
      "name": "garage-vehicle-server-debug",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "RUST_LOG=info,web_fps_server::snapshot_builder=debug VIBE_GARAGE_BALL_MASS=${VIBE_GARAGE_BALL_MASS:-1000} exec scripts/perf/garage-vehicle-server.sh --no-build"
      ],
      "port": 4001
    },
    {
      "name": "garage-vehicle-server-stock-city",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "VIBE_CITY_DESTRUCTIBLE_VEHICLES=0 VIBE_GARAGE_BALL_MASS=${VIBE_GARAGE_BALL_MASS:-1000} exec scripts/perf/garage-vehicle-server.sh --no-build"
      ],
      "port": 4001
    },
    {
      "name": "garage-vehicle-server-old-spin",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "VIBE_VEHICLE_LOOSE_OFFSET_SPIN=1 VIBE_GARAGE_BALL_MASS=${VIBE_GARAGE_BALL_MASS:-1000} exec scripts/perf/garage-vehicle-server.sh --no-build"
      ],
      "port": 4001
    }
  ]
}
