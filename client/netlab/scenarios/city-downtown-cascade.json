{
  "name": "city-downtown-cascade",
  "description": "Drive the whole downtown to collapse: cut supports at the base of every block in turn, then watch it settle. This is the scale ceiling test -- a full-city cascade reaches ~26,000 broken bonds and ~7,000 simultaneous bodies, which is where the server falls off 60 Hz. Gates are deliberately not tuned for this scenario; it exists to measure the ceiling and to prove the city still settles and stays uncorrupted at that scale.",
  "symptom": [
    "scale",
    "cascade",
    "overload"
  ],
  "path": "/city?portal=true",
  "matchId": "city-downtown-cascade-{iter}",
  "durationMs": 179000,
  "join": "auto",
  "serverEnv": {
    "VIBE_PHYSICS_BACKEND": "physx_gpu",
    "WT_STRICT_SNAPSHOT_DATAGRAMS": "1",
