# Build context hygiene: the Rust target dir alone is tens of GB and would be
# uploaded to the daemon on every build.
.git
.github
node_modules
target
dist
# ...except a bundle staged for the --prebuilt build path.
!dist/physx-server
client/node_modules
client/dist
client/test-results
control-plane/node_modules
control-plane/.wrangler
e2e/test-results
# Not excluded: vibe-land-shared include_str!()s worlds/trail.world.json, so
# dropping this directory fails the build with a missing-file error rather
# than a smaller context. 3.4 MB.
moq
infra/webtransport-demo
spacetimedb-module
docs
*.tar.gz
*.log
.env
.dev.vars
.certs
