+__device__ unsigned long long shapeKey(const Contact& c)
+{
+    const PxU32 lo = min(c.transformCacheRef0, c.transformCacheRef1);
+    const PxU32 hi = max(c.transformCacheRef0, c.transformCacheRef1);
+    return (static_cast<unsigned long long>(lo) << 32) | hi;
+}
+__global__ void contactProvenanceKeys(const Contact* input, PxU32 count,
+    unsigned long long* keys, PxU32* indices)
+{
+    const PxU32 i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= count) return;
+    keys[i] = input[i].pairIndex; indices[i] = i;
+}
+__global__ void contactSecondaryKeys(const Contact* input, PxU32 count,
+    unsigned long long* keys, const PxU32* indices)
+{
+    const PxU32 i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= count) return;
+    const auto& c = input[indices[i]];
+    keys[i] = (static_cast<unsigned long long>(c.friction) << 32) | c.pointIndex;
+}
+__global__ void contactPrimaryKeys(const Contact* input, PxU32 count,
+    unsigned long long* keys, const PxU32* indices)
+{
+    const PxU32 i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i < count) keys[i] = shapeKey(input[indices[i]]);
+}
+__global__ void gatherCanonicalContacts(const Contact* input, PxU32 count,
+    const PxU32* indices, Contact* output, PxU32* ambiguous)
+{
+    const PxU32 i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= count) return;
