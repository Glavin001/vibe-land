+            c.actor1 = reinterpret_cast<PxRigidActor*>(uintptr_t(c.transformCacheRef1));
+            c.pointIndex = ((i % 31) % 5) * 0x30000000u;
+            c.pairIndex = ((i % 31) / 5) * 0x28000000u;
