+// Caller holds PhysX's CUDA context and serializes calls on its stream.
+// Outputs are borrowed until next call/release; input is never modified.
+bool launchDirectGpuContactOrder(void*& workspace, const Contact* input, PxU32 count,
+    const Contact*& output, const PxU32*& ambiguous, CUstream cuStream)
+{
+    output = nullptr; ambiguous = nullptr;
+    if (!input || !count) return false;
+    auto* w = static_cast<ContactSortWorkspace*>(workspace);
+    if (!w)
+    {
+        w = new (std::nothrow) ContactSortWorkspace;
+        if (!w) return false;
+        workspace = w;
+    }
+    const auto stream = reinterpret_cast<cudaStream_t>(cuStream);
+    if (count > w->capacity)
+    {
+        // Grow geometrically to avoid allocating on each new high-water mark.
+        // Storage capacity never changes how many contacts are processed.
+        if (cudaStreamSynchronize(stream) != cudaSuccess) return false;
+        const size_t grown = static_cast<size_t>(w->capacity) * 2;
+        const PxU32 capacity = grown > count && grown <= UINT32_MAX ? PxU32(grown) : count;
+        w->freeItems();
+        if (cudaMalloc(&w->keys[0], size_t(capacity) * sizeof(*w->keys[0])) != cudaSuccess
+            || cudaMalloc(&w->keys[1], size_t(capacity) * sizeof(*w->keys[1])) != cudaSuccess
+            || cudaMalloc(&w->indices[0], size_t(capacity) * sizeof(*w->indices[0])) != cudaSuccess
+            || cudaMalloc(&w->indices[1], size_t(capacity) * sizeof(*w->indices[1])) != cudaSuccess
+            || cudaMalloc(&w->contacts, size_t(capacity) * sizeof(*w->contacts)) != cudaSuccess)
+            return false;
+        w->capacity = capacity;
+    }
+    if (!w->ambiguous && cudaMalloc(&w->ambiguous, sizeof(*w->ambiguous)) != cudaSuccess) return false;
+    cub::DoubleBuffer<unsigned long long> keys(w->keys[0], w->keys[1]);
+    cub::DoubleBuffer<PxU32> indices(w->indices[0], w->indices[1]);
+    size_t bytes = 0, provenanceBytes = 0;
+    if (cub::DeviceRadixSort::SortPairs(nullptr, bytes, keys, indices, count, 0, 64, stream)
+        != cudaSuccess || cub::DeviceRadixSort::SortPairs(nullptr, provenanceBytes,
+            keys, indices, count, 0, 32, stream) != cudaSuccess) return false;
+    if (provenanceBytes > bytes) bytes = provenanceBytes;
+    if (bytes > w->scratchBytes)
+    {
+        if (cudaStreamSynchronize(stream) != cudaSuccess) return false;
+        cudaFree(w->scratch); w->scratch = nullptr; w->scratchBytes = 0;
+        if (cudaMalloc(&w->scratch, bytes) != cudaSuccess) return false;
+        w->scratchBytes = bytes;
+    }
+    if (cudaMemsetAsync(w->ambiguous, 0, sizeof(*w->ambiguous), stream) != cudaSuccess) return false;
+    const auto sort = [&](int bits) {
+        // Keep allocated capacity distinct from CUB's in/out size argument.
+        size_t available = w->scratchBytes;
+        return cub::DeviceRadixSort::SortPairs(w->scratch, available, keys, indices,
+            count, 0, bits, stream);
+    };
+    const PxU32 blocks = count / 256 + (count % 256 != 0);
+    contactProvenanceKeys<<<blocks, 256, 0, stream>>>(input, count, keys.Current(), indices.Current());
+    if (cudaGetLastError() != cudaSuccess
+        || sort(32) != cudaSuccess) return false;
+    contactSecondaryKeys<<<blocks, 256, 0, stream>>>(input, count, keys.Current(), indices.Current());
+    if (cudaGetLastError() != cudaSuccess
+        || sort(64) != cudaSuccess) return false;
+    contactPrimaryKeys<<<blocks, 256, 0, stream>>>(input, count, keys.Current(), indices.Current());
+    if (cudaGetLastError() != cudaSuccess
+        || sort(64) != cudaSuccess) return false;
+    gatherCanonicalContacts<<<blocks, 256, 0, stream>>>(input, count,
+        indices.Current(), w->contacts, w->ambiguous);
+    if (cudaGetLastError() != cudaSuccess) return false;
+    output = w->contacts; ambiguous = w->ambiguous;
+    return true;
+}
+void releaseDirectGpuContactOrder(void* workspace)
+{
+    delete static_cast<ContactSortWorkspace*>(workspace);
+}
