+// Sort indices rather than entire records. Stable least-significant-first
+// passes retain source-pair provenance, then friction/pointIndex, then the
+// canonical shape pair. All five 32-bit fields retain their full range.
+struct ContactSortWorkspace
+{
+    unsigned long long* keys[2]{};
+    PxU32* indices[2]{};
+    Contact* contacts{};
+    PxU32* ambiguous{};
+    void* scratch{};
+    size_t scratchBytes{};
+    PxU32 capacity{};
+    void freeItems()
+    {
+        for (auto& p : keys) { cudaFree(p); p = nullptr; }
+        for (auto& p : indices) { cudaFree(p); p = nullptr; }
+        cudaFree(contacts); contacts = nullptr; capacity = 0;
+    }
+    ~ContactSortWorkspace()
+    {
+        freeItems(); cudaFree(ambiguous); cudaFree(scratch);
+    }
