+bool Sc::Scene::finalizeGpuSleep(BodyCore* body)
+{
+    if(!(mPublicFlags & PxSceneFlag::eENABLE_DIRECT_GPU_SLEEPING) || mGpuSleepPendingBodies.size() == 0)
+        return true;
