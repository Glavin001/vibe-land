FROM ubuntu:24.04

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/vibe-land
COPY dist/physx-server/ ./

ENV NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    VIBE_PHYSICS_BACKEND=physx_gpu \
    WT_STRICT_SNAPSHOT_DATAGRAMS=1 \
    BIND_ADDR=0.0.0.0:4001 \
    WT_BIND_ADDR=0.0.0.0:4433

EXPOSE 4001/tcp 4433/udp
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 \
    CMD curl --fail --silent http://127.0.0.1:4001/healthz || exit 1

ENTRYPOINT ["/opt/vibe-land/run.sh"]
